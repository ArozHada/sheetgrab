{
  "manifest_version": 3,
  "name": "SheetGrab",
  "version": "0.1.0",
  "description": "Clip job postings, internships and papers from any page into your Google Sheet.",
  "homepage_url": "https://ArozHada.github.io/sheetgrab/",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["identity", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://sheets.googleapis.com/*"],
  "oauth2": {
    "client_id": "357545592219-a5pemn2n4c1eaj85s6cevf0bvnpnkku3.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/spreadsheets"]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SheetGrab: save this page to your Sheet",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
